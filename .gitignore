# Python environment (setup.sh rebuilds it from requirements.lock)
.venv/
__pycache__/
*.pyc

# Per-machine data: temporary conversion files, error logs, request cooldowns
work/
state/

# The browser model files DO ship: the website serves them, so they have to be in the
# repo. Rebuild them with web/export_models.py. The backbone is split into pieces
# because no static host serves a 63 MB file as one lump.

# Test fixtures for the workbench pages: generated, and not needed by the website.
web/test/

# The built Mac app and its zip, made by mac/build_app.py
mac/build/

.DS_Store
